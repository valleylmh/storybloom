{
  "name": "storybloom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "audio:generate-featured": "node --env-file=.env --import tsx scripts/generate-featured-audio.mjs",
    "library:generate": "tsx scripts/generate-library-book.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/media": "4.0.490",
    "@remotion/web-renderer": "4.0.490",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.0",
    "nanoid": "^5.1.9",
    "next": "15.5.15",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "4.0.490",
    "resend": "^6.17.2",
    "svix": "^1.96.1",
    "tailwind-merge": "^2.5.0",
    "ws": "^8.21.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.19.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "4.20.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.87.0"
  }
}

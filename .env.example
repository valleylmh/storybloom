# ── AI APIs ─────────────────────────────────────────────────────────────────
# Story text model: your OpenAI-compatible endpoint. If CPA_BASE_URL or CPA_API_KEY is absent, StoryBloom uses a grounded local fallback story.
STORY_TEXT_PROVIDER=cpa
STORY_TEXT_MODEL=gemini-3-flash
CHARACTER_VISION_MODEL=gemini-3-flash
STORY_TEXT_TIMEOUT_MS=120000
STORY_TEXT_MAX_TOKENS=8192
STORY_TEXT_MAX_ATTEMPTS=2

# Image model: used by src/lib/image-generator.ts. If absent in local/dev, demo SVG images are used.
# Provider order also supports weights, e.g. pages below are distributed across providers.
# If a provider fails, the request falls back through this same order. Pollinations needs no API key.
IMAGE_PROVIDER_ORDER=agnes:2,pollinations:2,cloudflare:2,dashscope:2,huggingface:2
# Uploaded-character image-to-image providers. Same order/weight syntax as IMAGE_PROVIDER_ORDER.
IMAGE_TO_IMAGE_PROVIDER_ORDER=agnes:1,cpa:1
IMAGE_GENERATION_CONCURRENCY=4
AGNES_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_SIZE=1024x768
AGNES_IMAGE_REQUEST_DELAY_MS=1500
AGNES_IMAGE_RETRY_DELAY_MS=8000
AGNES_IMAGE_MAX_ATTEMPTS=2
CPA_IMAGE_MODEL=gemini-3.1-flash-image
# Family photo character sheets and every page using those characters are CPA-only.
CPA_IMAGE_REQUEST_DELAY_MS=1500
CPA_IMAGE_RETRY_DELAY_MS=8000
CPA_IMAGE_MAX_ATTEMPTS=2
CPA_IMAGE_TIMEOUT_MS=120000
POLLINATIONS_IMAGE_SIZE=512
POLLINATIONS_IMAGE_WIDTH=512
POLLINATIONS_IMAGE_HEIGHT=512
POLLINATIONS_IMAGE_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
CLOUDFLARE_IMAGE_REQUEST_DELAY_MS=2000
CLOUDFLARE_IMAGE_RETRY_DELAY_MS=5000
CLOUDFLARE_IMAGE_MAX_ATTEMPTS=2
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro
DASHSCOPE_IMAGE_SIZE=512*512
DASHSCOPE_IMAGE_CONCURRENCY=1
DASHSCOPE_IMAGE_REQUEST_DELAY_MS=22000
DASHSCOPE_IMAGE_RATE_LIMIT_RETRY_MS=70000
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_IMAGE_SIZE=512
HUGGINGFACE_IMAGE_WIDTH=512
HUGGINGFACE_IMAGE_HEIGHT=512
HUGGINGFACE_IMAGE_REQUEST_DELAY_MS=1500
HUGGINGFACE_IMAGE_RETRY_DELAY_MS=8000
HUGGINGFACE_IMAGE_MAX_ATTEMPTS=2

# Video narration prefers Token Plan TTS when DASHSCOPE_TOKEN_KEY is set.
# If configured but unavailable, video narration falls directly back to Edge.
# When Token Plan is not configured, the existing Gemini -> Edge route remains available.
DASHSCOPE_TOKEN_KEY=
TOKEN_PLAN_TTS_ENABLED=1
TOKEN_PLAN_TTS_VOICE_ZH=longanlingxin
TOKEN_PLAN_TTS_VOICE_EN=longanlufeng
TOKEN_PLAN_TTS_TIMEOUT_MS=5000
# Family-character voice cloning uses the standard DashScope customization
# API, not the Token Plan TTS credential above. BAILIAN_VOICE_CLONING_API_KEY
# can be omitted when DASHSCOPE_API_KEY is already a standard Bailian API key.
# Disabled by default. Set to 1 and rebuild/redeploy to expose the client entry.
NEXT_PUBLIC_FAMILY_VOICE_CLONING_ENABLED=0
BAILIAN_VOICE_CLONING_API_KEY=
BAILIAN_VOICE_CLONING_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
BAILIAN_VOICE_CLONING_TIMEOUT_MS=30000
FAMILY_VOICE_ENROLLMENT_RATE_LIMIT_PER_HOUR=12
FAMILY_VOICE_SAMPLE_READ_RETRY_MS=250
# Gemini 2.5 Flash TTS then Gemini 3.1 Flash TTS are the next providers
# when GEMINI_API_KEY is set. Example: GEMINI_API_KEY=key-1,key-2
# Keys are tried from left to right before moving to the next model.
# Gemini returns 24 kHz PCM, which StoryBloom wraps as WAV. Set GEMINI_TTS_ENABLED=0
# to force the no-key Edge TTS fallback.
GEMINI_API_KEY=
GEMINI_TTS_ENABLED=1
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE_ZH=Leda
GEMINI_TTS_VOICE_EN=Aoede
# Total time budget for all keys on one Gemini model; shared across key attempts.
GEMINI_TTS_TIMEOUT_MS=15000
GEMINI_TTS_MAX_ATTEMPTS=1
# Edge TTS remains the automatic fallback and needs no API key.
EDGE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_EN=en-US-AnaNeural
EDGE_TTS_TIMEOUT_MS=25000
EDGE_TTS_MAX_ATTEMPTS=2
# Optional protocol override. Keep wss:// outside tests.
EDGE_TTS_WEBSOCKET_URL=wss://speech.platform.bing.com/consumer/speech/synthesize/readaloud/edge/v1
# Private story-audio objects are returned through short-lived signed URLs.
STORY_AUDIO_SIGNED_URL_TTL_SECONDS=3600

# ── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# If absent, local in-memory rate limiting is used.
FREE_GENERATION_DAILY_LIMIT=3
NEXT_PUBLIC_FREE_GENERATION_DAILY_LIMIT=3
# Per story, including initial pages, automatic fallback, and manual redraws.
ILLUSTRATION_RATE_LIMIT_PER_STORY=64
# Vercel KV / Upstash integration may provide KV_REST_API_URL and KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase: auth, family profiles, private photos, and newsletter ──────────
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> anon key (legacy) or publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend: double opt-in newsletter ────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=StoryBloom <hello@example.com>
RESEND_REPLY_TO_EMAIL=
RESEND_TOPIC_ID=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_CONSENT_VERSION=2026-07
NEWSLETTER_ACTION_SECRET=
CPA_API_KEY=
# Example: https://your-provider.example/v1
CPA_BASE_URL=
CPA_TEXT_MODEL=gemini-3-flash
CPA_TEXT_TIMEOUT_MS=30000
NEWSLETTER_SEND_CONCURRENCY=5
CRON_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORY_VIDEO_ENABLED=1
# Optional. Use free-license only if your organization qualifies under Remotion's license.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=
NEXT_PUBLIC_XIAOHONGSHU_ORDER_URL=
NEXT_PUBLIC_XIANYU_ORDER_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
TURNSTILE_SECRET_KEY=
STORYBLOOM_ALLOW_DEMO_IMAGES=1  # local/dev only; production should use real image generation
NODE_ENV=development

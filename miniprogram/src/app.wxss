page { background: #f8f3e9; color: #342e28; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 16px; }
view, text, button, input, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0 14px; min-height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 14px; font-size: 15px; line-height: 1.4; background: #eee6da; color: #574a3e; }
button::after { border: none; }
button[disabled] { background: #eee9e0; color: #9b9389; }
.primary { background: #c45833; color: #fff; }
.quiet { background: transparent; color: #785f4e; }
.muted { color: #776d62; font-size: 13px; line-height: 1.6; }
.screen { padding: 20px 18px 28px; }
.empty { padding: 60px 20px; text-align: center; color: #776d62; line-height: 1.8; }
.empty button { margin-top: 20px; }
.notice { padding: 12px 16px; border-radius: 12px; background: #fff0e7; color: #8a4d35; font-size: 14px; }

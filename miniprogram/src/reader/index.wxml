<view wx:if="{{ready}}" class="reader {{audioEnabled ? 'with-audio' : ''}}">
  <view class="reader-meta"><text class="series">{{summary.seriesTitle}}</text><button class="quiet heart {{favorite ? 'hearted' : ''}}" bindtap="favorite" aria-label="{{favorite ? '取消收藏' : '收藏'}}">{{favorite ? '♥' : '♡'}}</button><button class="quiet" bindtap="openGuide">阅读指南</button></view>
  <view class="spread" bindtouchstart="touchStart" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
    <media-image eager="{{true}}" src="{{current.image}}" label="{{summary.title}}第{{pageIndex + 1}}页插图，点击放大" mode="aspectFit" bind:open="preview" />
    <view class="texts">
      <text class="paragraph zh {{highlight === 'zh' ? 'highlight' : ''}}" user-select="{{true}}">{{current.zh}}</text>
      <text class="paragraph en {{highlight === 'en' ? 'highlight' : ''}}" user-select="{{true}}">{{current.en}}</text>
    </view>
  </view>
  <view class="controls">
    <view wx:if="{{audioEnabled}}">
      <view wx:if="{{audioError}}" class="audio-error" aria-live="polite">{{audioError}}</view>
      <view wx:if="{{status === 'ended'}}" class="completed">这本故事读完啦</view>
      <view class="audio-controls">
        <picker range="{{languageLabels}}" value="{{modeIndex}}" bindchange="changeLanguage" aria-label="选择朗读语言"><view class="language">朗读语言 <text>{{languageLabels[modeIndex]}} ▾</text></view></picker>
        <button class="primary play" bindtap="toggleAudio">{{status === 'loading' ? '加载中 · 暂停' : active ? 'Ⅱ 暂停' : '▶ 播放'}}</button>
      </view>
    </view>
    <view class="pagination"><button disabled="{{pageIndex === 0}}" bindtap="previous">‹ 上一页</button><text class="page-number">{{pageIndex + 1}} / {{pageCount}}</text><button disabled="{{pageIndex + 1 === pageCount}}" bindtap="next">下一页 ›</button></view>
  </view>
  <view wx:if="{{guideOpen}}" class="guide-backdrop" bindtap="closeGuide" catchtouchmove="blockMove">
    <view class="guide-panel" catchtap="blockMove">
      <view class="guide-header"><text>阅读指南</text><button class="quiet" bindtap="closeGuide" aria-label="关闭阅读指南">关闭</button></view>
      <scroll-view class="guide-scroll" scroll-y="{{true}}"><view class="guide-content"><view wx:for="{{guide}}" wx:key="title" class="guide-section"><view class="guide-title">{{item.title}}</view><text class="guide-body" user-select="{{true}}">{{item.body}}</text></view></view></scroll-view>
    </view>
  </view>
</view>
<view wx:if="{{missing}}" class="empty"><view>这本绘本暂时无法打开</view><button class="primary" bindtap="browse">去绘本馆看看</button></view>

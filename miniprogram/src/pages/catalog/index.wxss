.eyebrow { color: #a55a3f; font-size: 11px; letter-spacing: 2px; }
.heading { margin-top: 10px; font-size: 25px; font-weight: 600; line-height: 1.45; }
.intro { margin-top: 8px; }
.search { display: flex; align-items: center; gap: 10px; margin-top: 22px; padding: 0 14px; height: 48px; border: 1px solid #e8ddce; border-radius: 16px; background: #fffdf8; }
.search text { font-size: 28px; color: #8e8171; }
.search input { flex: 1; min-width: 0; font-size: 15px; }
.filters-sticky { position: sticky; top: 0; z-index: 20; margin: 12px -18px 16px; padding: 10px 18px; background: #f8f3e9; border-bottom: 1px solid #e8ddce; }
.filters { white-space: nowrap; width: 100%; }
.filter { display: inline-flex; margin-right: 8px; font-size: 14px; background: #eee6da; border-radius: 22px; }
.filter.selected { color: white; background: #bd5734; }
.books { display: flex; flex-wrap: wrap; justify-content: space-between; }
.book { width: calc((100% - 14px) / 2); margin-bottom: 24px; min-width: 0; }
.title { margin: 10px 0 4px; font-weight: 600; font-size: 16px; line-height: 1.5; min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
